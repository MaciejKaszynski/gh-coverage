#!/usr/bin/env bash
# gh coverage <PR-NUMBER | BRANCH> [-R owner/repo]
# Downloads the coverage artifact of the latest run for a PR's head commit (or,
# given a branch name such as "main", the latest run on that branch), unzips it
# to <output_dir>/<PR|BRANCH>-<RUN>-coverage/ and opens <index> (see --help).
set -euo pipefail

log() { echo "[gh-coverage] $*" >&2; }

# Settings, lowest to highest precedence:
#   defaults < config file < GH_COVERAGE_* env vars < command-line flags
# Config file: ${XDG_CONFIG_HOME:-~/.config}/gh-coverage/config, KEY=value lines
# (keys: repo, artifact, workflow, output_dir, index; '#' starts a comment). Not sourced.
repo="" artifact="coverage-html" workflow="PR" output_dir="/tmp" index_path="coverage_linux/index.html"

config="${GH_COVERAGE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/gh-coverage/config}"
if [[ -f "$config" ]]; then
  log "reading config $config"
  while IFS='=' read -r key val; do
    key="${key//[[:space:]]/}"; val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
    val="${val%\"}"; val="${val#\"}"
    case "$key" in
      repo) repo="$val" ;;
      artifact) artifact="$val" ;;
      workflow) workflow="$val" ;;
      output_dir) output_dir="${val/#\~/$HOME}" ;;
      index) index_path="$val" ;;
      ''|\#*) ;;
      *) log "ignoring unknown config key '$key'" ;;
    esac
  done < "$config"
fi

repo="${GH_COVERAGE_REPO:-$repo}"
artifact="${GH_COVERAGE_ARTIFACT:-$artifact}"
workflow="${GH_COVERAGE_WORKFLOW:-$workflow}"
output_dir="${GH_COVERAGE_OUTPUT_DIR:-$output_dir}"
index_path="${GH_COVERAGE_INDEX:-$index_path}"

usage() {
  cat >&2 <<USAGE
Usage: gh coverage <PR-NUMBER | BRANCH> [options]
  -R, --repo OWNER/REPO   repository (default: current repo)
  -o, --output-dir DIR    base dir for <PR|BRANCH>-<RUN>-coverage (default: $output_dir)
  -i, --index PATH        file to open, relative to the extracted dir (default: $index_path)
  -a, --artifact NAME     artifact name (default: $artifact)
  -w, --workflow NAME     only consider runs with this name (default: $workflow)
Config file: $config
USAGE
  exit 1
}

target=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -R|--repo) repo="${2:-}"; shift 2 ;;
    -o|--output-dir) output_dir="${2:-}"; shift 2 ;;
    -i|--index) index_path="${2:-}"; shift 2 ;;
    -a|--artifact) artifact="${2:-}"; shift 2 ;;
    -w|--workflow) workflow="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    *) target="$1"; shift ;;
  esac
done
[[ -n "$target" ]] || usage

[[ -n "$repo" ]] || repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
log "repo: $repo"

if [[ "$target" =~ ^[0-9]+$ ]]; then
  read -r branch sha < <(gh pr view "$target" -R "$repo" --json headRefName,headRefOid \
                           --jq '[.headRefName,.headRefOid]|@tsv')
  log "PR #$target head branch: $branch, head sha: $sha"
  runs_query="head_sha=$sha"
  what="$sha"
else
  log "branch: $target"
  runs_query="branch=$target"
  what="branch $target"
fi

# Coverage is produced inside a (reusable) workflow, so the artifact lives on
# the calling run. Only runs named "$workflow" are considered; look at runs for the head commit (or branch),
# newest first.
log "looking for runs named '$workflow' at $what with artifact '$artifact'"
run=""
while IFS=$'\t' read -r id name event status conclusion; do
  log "  run $id: workflow='$name' event=$event status=$status conclusion=${conclusion:-none}"
  match=$(gh api "repos/$repo/actions/runs/$id/artifacts?per_page=100" \
            --jq "[.artifacts[]|select(.name==\"$artifact\" and (.expired|not))]|length")
  if [[ "$match" -gt 0 ]]; then
    log "  -> found non-expired '$artifact' artifact"
    run="$id"; break
  fi
  log "  -> no '$artifact' artifact"
done < <(GH_COVERAGE_WORKFLOW="$workflow" gh api "repos/$repo/actions/runs?$runs_query&per_page=100" \
           --jq '.workflow_runs|map(select(.name==$ENV.GH_COVERAGE_WORKFLOW))|sort_by(.created_at)|reverse|.[]|[.id,.name,.event,.status,.conclusion]|@tsv')

[[ -n "$run" ]] || { log "no run named '$workflow' with artifact '$artifact' for $what (set --workflow/--artifact or GH_COVERAGE_WORKFLOW/GH_COVERAGE_ARTIFACT to override)"; exit 1; }

out="${output_dir%/}/${target//\//_}-${run}-coverage"
rm -rf "$out"; mkdir -p "$out"
log "downloading '$artifact' from run $run -> $out"
gh run download "$run" -R "$repo" -n "$artifact" -D "$out"

# Artifact may itself contain a zip; unpack nested zips.
while IFS= read -r -d '' z; do
  log "unzipping nested $z"
  unzip -q -o "$z" -d "$(dirname "$z")" && rm -- "$z"
done < <(find "$out" -name '*.zip' -print0)

index="$out/$index_path"
[[ -f "$index" ]] || { log "$index not found; contents of $out:"; ls -R "$out" >&2; exit 1; }
log "opening $index"
xdg-open "$index" >/dev/null 2>&1 &
